# ---> Go
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
.directory

# Test binary, built with `go test -c`
*.test
*.cover.out
coverage.out
*.report
*.html

# IDE shenanigans
*.iml
.idea/

# build output
dist/
# local build of the binary
/dibs
# local dev config seeded by `make run`
/dibs.dev.yaml

# local env (secrets, API keys)
.env

# password files
*.pw

# editor backup files
*~

# markers left behind by running the tool against the sample dirs
zarf/sample/**/.dibs.json

# AI stuff
.playwright-mcp/
docs/superpowers
.superpowers
.tokensave
